# Flask / session security
FLASK_SECRET_KEY=replace-with-strong-random-secret
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_SECONDS=43200

# Database (Turso)
DATABASE_URL=libsql+https://your-db.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-auth-token

# Google Sheets backup
SPREADSHEET_ID=your-google-sheet-id
# For Cloud Run use secret/env JSON instead of local file path:
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# Discord OAuth
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=https://your-domain/auth/callback
ALLOWED_DISCORD_IDS=123456789012345678
SETTINGS_ADMIN_DISCORD_IDS=123456789012345678

# Bot API auth (prefer scoped tokens)
WEB_APP_API_READ_TOKEN=replace-with-read-token
WEB_APP_API_WRITE_TOKEN=replace-with-write-token
# Optional legacy fallback (recommended to leave unset)
# WEB_APP_API_TOKEN=

# Replay protection for bot write routes (recommended ON in production)
BOT_API_REPLAY_PROTECTION_ENABLED=true
BOT_API_REPLAY_WINDOW_SECONDS=300
BOT_API_NONCE_TTL_SECONDS=600
BOT_API_NONCE_CACHE_SIZE=10000

# Period automation (web-side gates)
AUTO_CREATE_PERIODS_ENABLED=true
AUTO_CREATE_PERIODS_OPEN_LEAD_DAYS=1
AUTO_CREATE_PERIODS_DEFAULT_LENGTH_DAYS=14
AUTO_CREATE_PERIODS_DEFAULT_GAP_DAYS=0
AUTO_CLOSE_PERIODS_ENABLED=true

# Optional diagnostics (recommended OFF in production)
LOCAL_STATUS_ENABLED=false
