BOT_TOKEN=
CLIENT_ID=
TEST_GUILD_ID=
TEST_REQUESTER_DISCORD_ID=
BOT_TESTER_IDS=

# Optional API bridge to the Flask web app
WEB_APP_BASE_URL=http://127.0.0.1:5001
WEB_APP_API_TOKEN=
WEB_APP_API_READ_TOKEN=
WEB_APP_API_WRITE_TOKEN=
REQUEST_TIMEOUT_MS=10000
CONFIG_SYNC_INTERVAL_MS=120000
BOT_HEARTBEAT_INTERVAL_MS=120000

# Optional claim-context cache/retry tuning
CLAIM_CONTEXT_CACHE_TTL_MS=30000
CLAIM_CONTEXT_STALE_IF_ERROR_MS=300000
CLAIM_CONTEXT_MAX_RETRIES=2
CLAIM_CONTEXT_RETRY_BASE_MS=250

# Optional review notifier (issue #23): posts claim/spend approvals/denials
# into channels/threads whose names match character names.
REVIEW_NOTIFIER_ENABLED=false
REVIEW_NOTIFIER_GUILD_ID=
REVIEW_NOTIFIER_INTERVAL_MS=120000
REVIEW_NOTIFIER_LOOKBACK_SECONDS=86400

# Optional auto-night creator (issue #22): bot triggers server-side
# next-night creation when due.
AUTO_PERIOD_CREATOR_ENABLED=false
AUTO_PERIOD_CREATOR_INTERVAL_MS=3600000

# Optional auto-night closer: bot triggers server-side period close when
# end_date has passed, then DMs players who haven't submitted a claim.
AUTO_PERIOD_CLOSER_ENABLED=false
AUTO_PERIOD_CLOSER_GUILD_ID=
AUTO_PERIOD_CLOSER_INTERVAL_MS=3600000

# Optional submission notifier: posts to a staff channel when new XP claims
# or spend requests arrive, so staff don't have to poll the dashboard.
SUBMISSION_NOTIFIER_ENABLED=false
SUBMISSION_NOTIFIER_CHANNEL_ID=
SUBMISSION_NOTIFIER_INTERVAL_MS=120000
SUBMISSION_NOTIFIER_LOOKBACK_SECONDS=86400

# Optional issue #20: sunrise claim reminders (DMs to players with active
# characters who have not filed for the current open night).
CLAIM_REMINDER_ENABLED=false
CLAIM_REMINDER_GUILD_ID=
CLAIM_REMINDER_INTERVAL_MS=900000
CLAIM_REMINDER_WEEKDAY_LOCAL=0
CLAIM_REMINDER_HOUR_LOCAL=12
CLAIM_REMINDER_MINUTE_LOCAL=0
CLAIM_REMINDER_TIMEZONE=America/Chicago
CLAIM_REMINDER_SNOOZE_HOURS=24

# Optional passage-of-time scheduler (bot-only, no extra cloud services)
PASSAGE_OF_TIME_ENABLED=false
PASSAGE_OF_TIME_GUILD_ID=
PASSAGE_OF_TIME_CHANNEL_ID=
PASSAGE_OF_TIME_TEST_MODE=true
PASSAGE_OF_TIME_TEST_CHANNEL_ID=
PASSAGE_OF_TIME_INTERVAL_MS=300000
PASSAGE_OF_TIME_TIMEZONE=America/Chicago
PASSAGE_OF_TIME_KINDRED_ROLE_ID=
PASSAGE_OF_TIME_GHOUL_ROLE_ID=
PASSAGE_OF_TIME_MORTAL_ROLE_ID=

# Cadence anchors must be YYYY-MM-DD dates in local timezone.
# Sunrise and sunset events run every 2 weeks; downtime runs every 8 weeks.
PASSAGE_SUNRISE_WEEKDAY_LOCAL=0
PASSAGE_SUNRISE_HOUR_LOCAL=12
PASSAGE_SUNRISE_MINUTE_LOCAL=0
PASSAGE_SUNRISE_ANCHOR_DATE=

PASSAGE_SUNSET_WEEKDAY_LOCAL=2
PASSAGE_SUNSET_HOUR_LOCAL=12
PASSAGE_SUNSET_MINUTE_LOCAL=0
PASSAGE_SUNSET_ANCHOR_DATE=

PASSAGE_DOWNTIME_WEEKDAY_LOCAL=0
PASSAGE_DOWNTIME_HOUR_LOCAL=12
PASSAGE_DOWNTIME_MINUTE_LOCAL=0
PASSAGE_DOWNTIME_ANCHOR_DATE=

# Optional player-facing quick guide URL (Discord post, docs page, etc.)
PLAYER_GUIDE_URL=

# Optional player-facing web URL used in /xp help
PLAYER_WEB_URL=

# Optional Docker log retention controls (used by apps/bot/docker-compose.yml)
BOT_LOG_MAX_SIZE=25m
BOT_LOG_MAX_FILE=120
TZ=America/Chicago

# Optional Discord webhook URL for health alerts (used by scripts/check-bot-health.sh)
HEALTH_ALERT_WEBHOOK=

# Optional Discord role ID to ping when /combat start is used (e.g. Storyteller/ST role)
COMBAT_SYSTEM_HELPER_ROLE_ID=

# Optional channel ID for /staff broadcast announcements target
ANNOUNCEMENTS_CHANNEL_ID=

# Character approval (/lasombra approve)
# Channel ID for #player-character-sheets where approved sheets are posted
APPROVE_PLAYER_SHEETS_CHANNEL_ID=
# Role ID for "Sheet in Progress" — removed from player on approval
APPROVE_SHEET_IN_PROGRESS_ROLE_ID=

# Character creation ticket monitor
# Discord channel URL for creation rules (linked in Lasombra's welcome message)
CC_CREATION_RULES_URL=
# Optional: restrict monitor to specific category IDs (comma-separated).
# If set, only channels in these categories trigger the welcome message.
# If unset, any category whose name contains "character tickets" matches.
# Set this in dev/staging to avoid firing on prod ticket categories.
CC_TICKET_CATEGORY_IDS=
# Set to false on dev bots to prevent posting welcome messages in prod ticket channels.
CC_TICKET_MONITOR_ENABLED=true
# Character submission notifier: posts an embed in the player's ticket channel when
# they hit "Submit for Review" in the character creator.
# Enabled by default — set to false to disable.
CC_SUBMISSION_NOTIFIER_ENABLED=true
CC_SUBMISSION_NOTIFIER_INTERVAL_MS=60000
CC_SUBMISSION_NOTIFIER_LOOKBACK_SECONDS=86400

# CC approval notifier: posts approved characters to #player-character-sheets
CC_APPROVAL_NOTIFIER_ENABLED=true
CC_APPROVAL_NOTIFIER_INTERVAL_MS=60000
CC_APPROVAL_NOTIFIER_LOOKBACK_SECONDS=86400

# Optional nightly Google Sheets reconciliation (syncs DB → Sheets once per day)
# Set SHEETS_RECONCILE_ENABLED=true to activate; requires SHEETS integration on the web side.
SHEETS_RECONCILE_ENABLED=false
SHEETS_RECONCILE_HOUR_LOCAL=3
SHEETS_RECONCILE_MINUTE_LOCAL=0
SHEETS_RECONCILE_TIMEZONE=America/Chicago
# How often to check whether the scheduled time has arrived (default 5 min)
SHEETS_RECONCILE_INTERVAL_MS=300000

# Optional nightly wiki sync (re-runs Discord→Wiki sync once per day to refresh Discord CDN URLs)
# Set WIKI_SYNC_ENABLED=true to activate; requires DISCORD_GUILD_ID.
WIKI_SYNC_ENABLED=false
WIKI_SYNC_HOUR_LOCAL=4
WIKI_SYNC_MINUTE_LOCAL=0
WIKI_SYNC_TIMEZONE=America/Chicago
# How often to check whether the scheduled time has arrived (default 5 min)
WIKI_SYNC_INTERVAL_MS=300000

# Cubby sync: scans Character Cubby channels, backfills ticket_channel_id by name match,
# and auto-retires characters whose cubby is deleted or moved to the Retired Characters category.
# Set CUBBY_SYNC_ENABLED=true to activate; requires DISCORD_GUILD_ID (or CUBBY_SYNC_GUILD_ID).
CUBBY_SYNC_ENABLED=false
# How often to scan (default 1 hour)
CUBBY_SYNC_INTERVAL_MS=3600000
# Guild to scan (defaults to DISCORD_GUILD_ID)
CUBBY_SYNC_GUILD_ID=
# Optional staff channel to post a summary when characters are retired or backfilled
CUBBY_SYNC_STAFF_CHANNEL_ID=
# Discord category ID for the "Retired Characters" category (default: 1225070632799043685)
CUBBY_RETIRED_CATEGORY_ID=1225070632799043685

# Retirement automation: immediate Discord retirement moves + deferred wiki batch sync.
RETIREMENT_AUTOMATION_ENABLED=true
RETIREMENT_AUTOMATION_INTERVAL_MS=60000
RETIREMENT_AUTOMATION_GUILD_ID=
RETIREMENT_CHILDREN_FORUM_ID=1168655581486252042
RETIREMENT_RETIRED_FORUM_ID=1168669113871257682
RETIREMENT_WIKI_BATCH_ENABLED=true
RETIREMENT_WIKI_BATCH_HOUR_LOCAL=4
RETIREMENT_WIKI_BATCH_MINUTE_LOCAL=0
RETIREMENT_WIKI_BATCH_TIMEZONE=America/Chicago

# Override the slash command name for the Lasombra command (default: lasombra).
# Set to "dev-lasombra" on dev bots to avoid collisions with the prod bot in the same guild.
LASOMBRA_COMMAND_NAME=lasombra

# ---------------------------------------------------------------------------
# discord-wiki-sync (one-time script — not used by the running bot)
# Run: npm run wiki-sync:dry-run  /  npm run wiki-sync
# ---------------------------------------------------------------------------

# Discord server to read from (falls back to TEST_GUILD_ID)
DISCORD_GUILD_ID=

# Chronicle Wiki writes use WEB_APP_API_WRITE_TOKEN defined above — no extra var needed.

# ---------------------------------------------------------------------------
# Staff Role Sync — keep Discord roles as source of truth for staff membership
# ---------------------------------------------------------------------------
# Set to true to enable. Requires "Server Members Intent" on the bot application page.
STAFF_ROLE_SYNC_ENABLED=false
# Discord role IDs (defaults are the MCbN production role IDs; override if needed)
# STAFF_ROLE_SYSTEM_HELPER_ID=1168649906324520992
# STAFF_ROLE_STORYTELLER_ID=1168649373731790948
# STAFF_ROLE_MODERATOR_ID=1168650352132890794
# STAFF_ROLE_ADMINISTRATOR_ID=1168648955731648554
